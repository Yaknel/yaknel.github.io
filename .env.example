# Copia este archivo como .env.local para desarrollo.
# En GitHub: Settings → Secrets and variables → Actions → Variables.

# ID del formulario de Formspree (https://formspree.io), p. ej. "xkgnqwer".
# Los mensajes del formulario de contacto llegan a tu correo sin mostrarlo en la web.
VITE_FORMSPREE_ID=

# URL de tu Substack (para el formulario de suscripción).
VITE_SUBSTACK_URL=https://yaknel.substack.com
